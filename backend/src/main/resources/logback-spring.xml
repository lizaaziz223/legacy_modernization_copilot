<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <springProperty scope="context" name="appName" source="spring.application.name"
                    defaultValue="ai-legacy-modernization-copilot"/>
    <springProperty scope="context" name="consolePattern" source="logging.pattern.console"
                    defaultValue="${CONSOLE_LOG_PATTERN}"/>

    <!--
        Console/stdout only, deliberately. No file appender: Railway, Render and
        Northflank containers don't guarantee a writable filesystem at any given
        path, and Logback initializes before Spring Boot's own startup logic runs
        - a FileAppender that can't create its target file/directory fails during
        Logback's own bootstrap, which can crash the process before "Starting
        AiLegacyModernizationCopilotApplication" is ever logged. All of these
        platforms capture stdout/stderr directly, so a file appender adds risk
        with no benefit in this deployment model.
    -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${consolePattern}</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>
