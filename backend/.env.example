# Spring profile to activate: dev | prod
SPRING_PROFILES_ACTIVE=prod

# MongoDB (Atlas SRV connection, used by dev/prod profiles)
MONGODB_USER=<your-atlas-username>
MONGODB_PASSWORD=<your-atlas-password>
MONGODB_CLUSTER=<your-cluster>.mongodb.net
MONGODB_DATABASE=ai_legacy_modernization

# JWT
JWT_SECRET=change-me-to-a-256-bit-secret
APP_ADMIN_PASSWORD=admin123

# LLM providers
OPENAI_API_KEY=<your-openai-compatible-api-key>
OPENAI_BASE_URL=<your-openai-compatible-base-url>
OPENAI_MODEL=gpt-4o-mini

AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_LLM_MODEL=gpt-4
AZURE_LLM_DEPLOYMENT_ID=

# Storage
TEMP_UPLOAD_DIR=./temp-uploads
OUTPUT_DIR=./output-reports
